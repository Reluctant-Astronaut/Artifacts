# The five plugins of the suite, and the sources each one compiles besides the shared editor
set(STRIP_SOURCES  ${CMAKE_CURRENT_LIST_DIR}/Strip/StripProcessor.cpp)

function(artifacts_add TARGET PRODUCT CODE VARIANT SOURCES)
    artifacts_plugin(${TARGET} "${PRODUCT}" ${CODE} ${VARIANT} ${ARGN})
    target_sources(${TARGET} PRIVATE ${SOURCES})
    if(ARTIFACTS_TESTS)
        target_sources(${TARGET}Tests PRIVATE ${SOURCES})
        target_include_directories(${TARGET}Tests PRIVATE ${CMAKE_CURRENT_LIST_DIR}/Strip ${CMAKE_CURRENT_LIST_DIR}/Duality ${CMAKE_CURRENT_LIST_DIR}/Anemoia ${CMAKE_CURRENT_LIST_DIR}/Equanimity)
    endif()
    target_include_directories(${TARGET} PRIVATE ${CMAKE_CURRENT_LIST_DIR}/Strip ${CMAKE_CURRENT_LIST_DIR}/Duality ${CMAKE_CURRENT_LIST_DIR}/Anemoia ${CMAKE_CURRENT_LIST_DIR}/Equanimity)
endfunction()

artifacts_add(Console  "Console RA-1" ArC1 2 "${STRIP_SOURCES}" Dynamics)
artifacts_add(Kintsugi "Kintsugi"     ArK1 1 "${STRIP_SOURCES}" Distortion)

set(DUALITY_SOURCES ${CMAKE_CURRENT_LIST_DIR}/Duality/DualityProcessor.cpp ${CMAKE_CURRENT_LIST_DIR}/Duality/DualityARA.cpp)
artifacts_add(Duality "Duality" ArD1 3 "${DUALITY_SOURCES}" Reverb)
# Duality's ears (the words): whisper.cpp, in the plug-in only (the offline test rig has no ARA and no words)
target_sources(Duality PRIVATE ${CMAKE_CURRENT_LIST_DIR}/Duality/DualityWords.cpp)
target_compile_definitions(Duality PUBLIC DUALITY_WORDS=1)
target_link_libraries(Duality PRIVATE whisper)
# the word aligner's engine (ONNX Runtime) is loaded at run time: only its C header is needed to build (MIT)
target_include_directories(Duality PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../ThirdParty/onnxruntime)
# DualityListen: the same ears from the command line (the Mac build checks them on a spoken line)
juce_add_console_app(DualityListen PRODUCT_NAME "DualityListen")
target_sources(DualityListen PRIVATE ${CMAKE_CURRENT_LIST_DIR}/../Tests/DualityListen.cpp ${CMAKE_CURRENT_LIST_DIR}/Duality/DualityWords.cpp)
target_include_directories(DualityListen PRIVATE ${CMAKE_CURRENT_LIST_DIR}/Duality ${CMAKE_CURRENT_LIST_DIR}/../ThirdParty/onnxruntime)
target_compile_definitions(DualityListen PRIVATE JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0 DUALITY_WORDS=1)
target_link_libraries(DualityListen PRIVATE whisper juce::juce_audio_formats juce::juce_recommended_config_flags)
set_target_properties(DualityListen PROPERTIES EXCLUDE_FROM_ALL TRUE)

set(ANEMOIA_SOURCES ${CMAKE_CURRENT_LIST_DIR}/Anemoia/AnemoiaProcessor.cpp)
artifacts_add(Anemoia "Anemoia" ArA1 4 "${ANEMOIA_SOURCES}" Delay)

set(EQUANIMITY_SOURCES ${CMAKE_CURRENT_LIST_DIR}/Equanimity/EquanimityProcessor.cpp)
artifacts_add(Equanimity "Equanimity" ArE1 5 "${EQUANIMITY_SOURCES}" EQ)
